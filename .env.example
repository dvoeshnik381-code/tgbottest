BOT_TOKEN=123456789:replace_with_token_from_botfather
POLL_TIMEOUT_SECONDS=30
TIME_ZONE=Europe/Moscow

# Personal assistant: your numeric private chat/user ID
OWNER_CHAT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Windows shutdown: disabled by default, dry run until explicitly changed
PC_CONTROL_ENABLED=false
PC_DRY_RUN=true

# Alice webhook: start on your PC, then expose through an HTTPS tunnel
ALICE_ENABLED=false
ALICE_PORT=8080
ALICE_WEBHOOK_TOKEN=
ALICE_PAIRING_MODE=true
ALICE_USER_ID=
ALICE_APPLICATION_ID=
